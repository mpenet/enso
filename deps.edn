{:paths ["src/clj" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}}
 ;; Git/local consumers: `clojure -X:deps prep` compiles the Java sources
 ;; into target/classes.
 :deps/prep-lib {:alias :build :fn javac :ensure "target/classes"}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.13"}}
          :ns-default build}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                       com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}
                       io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       org.ring-clojure/ring-core-protocols {:mvn/version "1.15.5"}
                       org.ring-clojure/ring-websocket-protocols {:mvn/version "1.15.5"}}
          :extra-paths ["test"]
          :jvm-opts ["-Djdk.attach.allowAttachSelf"
                     "-XX:+UnlockDiagnosticVMOptions"
                     "-XX:+DebugNonSafepoints"]
          :main-opts ["-m" "nrepl.cmdline"]}
  :test {:extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}
                      org.ring-clojure/ring-core-protocols {:mvn/version "1.15.5"}
                      org.ring-clojure/ring-websocket-protocols {:mvn/version "1.15.5"}}
         :extra-paths ["test"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Standalone server process for conformance suites and the load harness.
  :test-server {:extra-paths ["test"]
                :main-opts ["-m" "s-exp.enso-test-server"]}
  ;; Out-of-process load generator + allocation/latency recorder.
  :perf {:extra-deps {org.hdrhistogram/HdrHistogram {:mvn/version "2.2.2"}}
         :extra-paths ["test"]
         :main-opts ["-m" "s-exp.enso-perf"]}
  ;; Allocation-per-request gate over a perf run (see doc/testing.md).
  :perf-gate {:extra-paths ["test"]
              :main-opts ["-m" "s-exp.enso-perf-gate"]}
  ;; JaCoCo agent + report CLI for script/coverage.sh; only their jar
  ;; paths are used (`clojure -Spath -A:coverage`), never a classpath.
  :coverage {:extra-deps {org.jacoco/org.jacoco.agent$runtime {:mvn/version "0.8.15"}
                          org.jacoco/org.jacoco.cli$nodeps {:mvn/version "0.8.15"}}}
  ;; Coverage-guided fuzzing (Jazzer); run through script/fuzz.sh.
  :fuzz {:extra-deps {com.code-intelligence/jazzer {:mvn/version "0.30.0"}}
         :extra-paths ["target/fuzz-classes"]}
  :bench {:extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}
                       ring/ring-jetty-adapter {:mvn/version "1.14.2"}
                       com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}
                       nrepl/nrepl {:mvn/version "1.3.1"}
                       ;; Netty HTTP/3 server for bench comparisons
                       io.netty.incubator/netty-incubator-codec-http3 {:mvn/version "0.0.28.Final"}
                       io.netty.incubator/netty-incubator-codec-native-quic$osx-aarch_64 {:mvn/version "0.0.66.Final"}
                       ;; Jetty HTTP/3 server for bench comparisons
                       org.eclipse.jetty.http3/jetty-http3-server {:mvn/version "12.0.14"}
                       org.eclipse.jetty.quic/jetty-quic-server {:mvn/version "12.0.14"}
                       org.eclipse.jetty.quic/jetty-quic-quiche-jna {:mvn/version "12.0.14"}}
          :extra-paths ["bench"]
          :jvm-opts ["-Djdk.attach.allowAttachSelf"
                     "-XX:+UnlockDiagnosticVMOptions"
                     "-XX:+DebugNonSafepoints"]
          :main-opts ["-m" "nrepl.cmdline"]}
  ;; Cross-server comparison (see doc/performance.md). The driver runs the
  ;; load; each peer server runs in its own JVM from its own alias, so
  ;; Aleph's Netty 4.1 and the Netty 4.2 HTTP/3 codec never share a
  ;; classpath.
  :bench/compare {:extra-deps {org.hdrhistogram/HdrHistogram {:mvn/version "2.2.2"}}
                  :extra-paths ["test" "bench"]
                  :main-opts ["-m" "enso.compare"]}
  :bench/http-kit {:extra-deps {http-kit/http-kit {:mvn/version "2.8.1"}}
                   :extra-paths ["test" "bench"]
                   :main-opts ["-m" "enso.peer.http-kit"]}
  :bench/jetty {:extra-deps {info.sunng/ring-jetty9-adapter {:mvn/version "0.40.5"}
                             info.sunng/ring-jetty9-adapter-http2 {:mvn/version "0.2.11"}
                             info.sunng/ring-jetty9-adapter-http3 {:mvn/version "0.7.11"}
                             org.eclipse.jetty.quic/jetty-quic-quiche-foreign {:mvn/version "12.1.14"}
                             ring/ring-core {:mvn/version "1.15.5"}}
                :extra-paths ["test" "bench"]
                :main-opts ["-m" "enso.peer.jetty"]}
  :bench/aleph {:extra-deps {aleph/aleph {:mvn/version "0.9.11"}}
                :extra-paths ["test" "bench"]
                :main-opts ["-m" "enso.peer.aleph"]}
  :bench/netty {:extra-deps {io.netty/netty-codec-http3 {:mvn/version "4.2.19.Final"}
                             io.netty/netty-codec-native-quic$osx-aarch_64 {:mvn/version "4.2.19.Final"}
                             io.netty/netty-codec-native-quic$osx-x86_64 {:mvn/version "4.2.19.Final"}
                             io.netty/netty-codec-native-quic$linux-x86_64 {:mvn/version "4.2.19.Final"}
                             io.netty/netty-codec-native-quic$linux-aarch_64 {:mvn/version "4.2.19.Final"}}
                :extra-paths ["test" "bench"]
                :main-opts ["-m" "enso.peer.netty"]}}}
