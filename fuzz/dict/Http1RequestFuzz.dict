"HEAD "
"POST "
"PUT "
"OPTIONS "
"CONNECT "
" HTTP/1.1\x0d\x0a"
" HTTP/1.0\x0d\x0a"
"\x0d\x0a"
"\x0d\x0a\x0d\x0a"
": "
"Host: "
"Content-Length: "
"Transfer-Encoding: chunked"
"Transfer-Encoding: "
"Connection: close"
"Connection: keep-alive"
"Connection: Upgrade"
"Expect: 100-continue"
"Upgrade: websocket"
"Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ=="
"Sec-WebSocket-Version: 13"
"Sec-WebSocket-Extensions: permessage-deflate"
"0\x0d\x0a\x0d\x0a"
";ext=v"
"chunked"
"gzip, chunked"
"%2F"
"?"
"#"
