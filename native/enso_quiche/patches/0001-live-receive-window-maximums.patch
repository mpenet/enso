+/// Sends as much stream data as flow control allows from the client on stream
+/// 0, reads it all on the server and lets the server update its limits.
+/// Returns the number of bytes transferred.
+fn transfer_round(pipe: &mut test_utils::Pipe) -> usize {
+    let mut buf = [0; 65535];
+
+    let sent = pipe
+        .client
+        .stream_send(0, &[42u8; 10_000], false)
+        .unwrap_or(0);
+    assert_eq!(pipe.advance(), Ok(()));
+
+    let mut read = 0;
+    while let Ok((len, _)) = pipe.server.stream_recv(0, &mut buf) {
+        read += len;
+    }
+    assert_eq!(read, sent);
+    assert_eq!(pipe.advance(), Ok(()));
+
+    sent
+}
