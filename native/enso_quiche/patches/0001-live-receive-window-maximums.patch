+#[rstest]
+/// Tests that raising the maximum connection window of a live connection
+/// lets the connection window autotune past the configured maximum.
+fn set_max_connection_window(
+    #[values("cubic", "bbr2_gcongestion")] cc_algorithm_name: &str,
+) {
+    let mut config = test_utils::Pipe::default_config(cc_algorithm_name).unwrap();
+    config.set_initial_max_data(30);
+    config.set_max_connection_window(30);
+    config.set_initial_max_stream_data_bidi_local(1000);
+    config.set_initial_max_stream_data_bidi_remote(1000);
+    config.set_max_stream_window(1000);
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Ok(()));
+
+    for _ in 0..4 {
+        assert_eq!(transfer_round(&mut pipe), 30);
+    }
+    assert_eq!(pipe.server.connection_window(), 30);
+
+    pipe.server.set_max_connection_window(10_000);
+
+    let mut last = 0;
+    for _ in 0..8 {
+        last = transfer_round(&mut pipe);
+    }
+    assert!(last > 30);
+    assert!(pipe.server.connection_window() > 30);
+    assert!(pipe.server.connection_window() <= 10_000);
+
+    // Never set below the current window.
+    let window = pipe.server.connection_window();
+    pipe.server.set_max_connection_window(10);
+    transfer_round(&mut pipe);
+    assert!(pipe.server.connection_window() >= window);
+}
+
+#[rstest]
+/// Tests that raising the maximum stream window of a live connection lets
+/// the window of an existing stream autotune past the configured maximum.
+fn set_max_stream_window(
+    #[values("cubic", "bbr2_gcongestion")] cc_algorithm_name: &str,
+) {
+    let mut config = test_utils::Pipe::default_config(cc_algorithm_name).unwrap();
+    config.set_initial_max_data(100_000);
+    config.set_initial_max_stream_data_bidi_local(30);
+    config.set_initial_max_stream_data_bidi_remote(30);
+    config.set_max_stream_window(30);
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Ok(()));
+
+    for _ in 0..4 {
+        assert_eq!(transfer_round(&mut pipe), 30);
+    }
+    assert_eq!(pipe.server.streams.get(0).unwrap().recv.window(), 30);
+
+    pipe.server.set_max_stream_window(1000);
+
+    let mut last = 0;
+    for _ in 0..8 {
+        last = transfer_round(&mut pipe);
+    }
+    assert!(last > 30);
+    let window = pipe.server.streams.get(0).unwrap().recv.window();
+    assert!(window > 30);
+    assert!(window <= 1000);
+}
