+    #[test]
+    fn gapped_fragments_limited() {
+        let mut recv =
+            RecvBuf::new(u64::MAX, DEFAULT_STREAM_WINDOW, DEFAULT_STREAM_WINDOW);
+
+        // One-byte fragments, each followed by a one-byte gap, offset 0
+        // withheld: refused once there are more than MIN_FRAGMENTS of them.
+        for i in 0..MIN_FRAGMENTS as u64 {
+            let buf = RangeBuf::from(b"a", 1 + 2 * i, false);
+            assert_eq!(recv.write(buf), Ok(()));
+        }
+        assert_eq!(recv.data.len(), MIN_FRAGMENTS);
+
+        let buf = RangeBuf::from(b"a", 1 + 2 * MIN_FRAGMENTS as u64, false);
+        assert_eq!(recv.write(buf), Err(Error::FlowControl));
+    }
+
+    #[test]
+    fn gapped_fragments_allowed_by_span() {
+        let mut recv = RecvBuf::new(u64::MAX, 1 << 20, 1 << 20);
+
+        // Fragments covering MIN_AVERAGE_FRAGMENT_LEN bytes of stream each
+        // (gap included) are accepted however many there are.
+        let data = [42; MIN_AVERAGE_FRAGMENT_LEN - 1];
+        for i in 0..(4 * MIN_FRAGMENTS) as u64 {
+            let off = 1 + i * MIN_AVERAGE_FRAGMENT_LEN as u64;
+            assert_eq!(recv.write(RangeBuf::from(&data, off, false)), Ok(()));
+        }
+        assert_eq!(recv.data.len(), 4 * MIN_FRAGMENTS);
+    }
+
+    #[test]
+    fn heavy_reordering_accepted() {
+        let window = 8 * 1024 * 1024;
+        let mut recv = RecvBuf::new(window, window, window);
+
+        // A full window of 1200-byte frames, one in two lost, then the
+        // losses retransmitted.
+        let frame = [42; 1200];
+        let frames = window / 1200;
+        for i in (1..frames).step_by(2) {
+            let buf = RangeBuf::from(&frame, i * 1200, false);
+            assert_eq!(recv.write(buf), Ok(()));
+        }
+        for i in (0..frames).step_by(2) {
+            let buf = RangeBuf::from(&frame, i * 1200, false);
+            assert_eq!(recv.write(buf), Ok(()));
+        }
+
+        // A full window of 1200-byte frames buffered after a single loss.
+        let mut recv = RecvBuf::new(window, window, window);
+        for i in 1..frames {
+            let buf = RangeBuf::from(&frame, i * 1200, false);
+            assert_eq!(recv.write(buf), Ok(()));
+        }
+    }
+
+    #[test]
+    fn small_contiguous_fragments_coalesced() {
+        let mut recv =
+            RecvBuf::new(u64::MAX, DEFAULT_STREAM_WINDOW, DEFAULT_STREAM_WINDOW);
+
+        // After a loss, contiguous ten-byte frames are coalesced instead of
+        // each taking an entry, once MIN_FRAGMENTS are buffered.
+        let mut expected = vec![0; 10];
+        for i in 1..2000_u64 {
+            let data = [(i % 256) as u8; 10];
+            expected.extend_from_slice(&data);
+            assert_eq!(recv.write(RangeBuf::from(&data, i * 10, false)), Ok(()));
+        }
+        assert!(
+            recv.data.len() <=
+                MIN_FRAGMENTS + 20_000 / (MAX_COALESCED_LEN / 2) + 1
+        );
+
+        // The loss is recovered: everything reads back in order.
+        assert_eq!(recv.write(RangeBuf::from(&[0; 10], 0, false)), Ok(()));
+        let mut out = vec![0; 20_000];
+        assert_eq!(recv.emit(&mut out), Ok((20_000, false)));
+        assert_eq!(out, expected);
+    }
