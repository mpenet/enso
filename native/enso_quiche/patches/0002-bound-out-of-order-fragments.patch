+#[rstest]
+/// Tests that a peer sending many tiny stream fragments separated by gaps is
+/// refused before they cost far more memory than their bytes.
+fn flow_control_gapped_fragments(
+    #[values("cubic", "bbr2_gcongestion")] cc_algorithm_name: &str,
+) {
+    let mut buf = [0; 65535];
+
+    let mut config = test_utils::Pipe::default_config(cc_algorithm_name).unwrap();
+    config.set_initial_max_data(1_000_000);
+    config.set_initial_max_stream_data_bidi_local(1_000_000);
+    config.set_initial_max_stream_data_bidi_remote(1_000_000);
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Ok(()));
+
+    // One-byte fragments one byte apart, offset 0 withheld.
+    let mut off = 1;
+    let mut result = Ok(0);
+    while result.is_ok() && off < 10_000 {
+        let frames: Vec<frame::Frame> = (0..50)
+            .map(|i| frame::Frame::Stream {
+                stream_id: 0,
+                data: <RangeBuf>::from(b"a", off + 2 * i, false),
+            })
+            .collect();
+        off += 100;
+
+        result = pipe.send_pkt_to_server(Type::Short, &frames, &mut buf);
+    }
+
+    assert_eq!(result, Err(Error::FlowControl));
+    assert!(off < 1_000);
+}
