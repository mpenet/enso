# ABOUTME: Pinned inputs of the native build, read by build-libquiche.sh and the CI workflows:
# ABOUTME: libquiche release and commit, Rust toolchain, oldest macOS the dylib supports.
# QUICHE_COMMIT is the commit the QUICHE_VERSION tag points at (tags can be
# moved); Quiche.QUICHE_VERSION must name the same release. Bumping any of
# these means regenerating quiche-Cargo.lock and THIRD-PARTY-NOTICES (see
# doc/build.md).
QUICHE_VERSION=0.29.3
QUICHE_COMMIT=55886df3be579579207104c8e645825b6347a209
RUST_TOOLCHAIN=1.97.0
MACOSX_DEPLOYMENT_TARGET=11.0
